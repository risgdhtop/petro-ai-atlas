\" opacity=\"0.55\"/><line x1=\"100\" y1=\"176\" x2=\"104\" y2=\"177\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"153\" y1=\"29\" x2=\"157\" y2=\"28\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"206\" y1=\"66\" x2=\"210\" y2=\"66\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"259\" y1=\"103\" x2=\"263\" y2=\"104\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"312\" y1=\"140\" x2=\"316\" y2=\"139\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"69\" y1=\"177\" x2=\"73\" y2=\"177\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"122\" y1=\"30\" x2=\"126\" y2=\"31\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"175\" y1=\"67\" x2=\"179\" y2=\"66\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"228\" y1=\"104\" x2=\"232\" y2=\"104\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"281\" y1=\"141\" x2=\"285\" y2=\"142\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"38\" y1=\"178\" x2=\"42\" y2=\"177\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"91\" y1=\"31\" x2=\"95\" y2=\"31\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"144\" y1=\"68\" x2=\"148\" y2=\"69\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"197\" y1=\"105\" x2=\"201\" y2=\"104\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"250\" y1=\"142\" x2=\"254\" y2=\"142\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><line x1=\"303\" y1=\"179\" x2=\"307\" y2=\"180\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linecap=\"round\" opacity=\"0.55\"/><text x=\"240\" y=\"44\" font-size=\"8.4\" fill=\"#235f51\">有效反射</text><text x=\"240\" y=\"74\" font-size=\"8.4\" fill=\"#8e5229\">面波</text><text x=\"30\" y=\"196\" font-size=\"8.4\" fill=\"#9ba3a9\">随机噪声</text><rect x=\"348\" y=\"6\" width=\"326\" height=\"196\" rx=\"5\" fill=\"#ffffff\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"358\" y=\"24\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">f–k 域：三类东西占不同的区域</text><rect x=\"366\" y=\"34\" width=\"290\" height=\"130\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><polygon points=\"396,164 486,44 516,44 426,164\" fill=\"#e6f1ec\" stroke=\"#2f7d6b\" stroke-width=\"1\" opacity=\"0.7\"/><text x=\"400\" y=\"156\" font-size=\"8\" fill=\"#235f51\">有效波（低波数）</text><polygon points=\"516,164 616,44 656,44 556,164\" fill=\"#f8ecdf\" stroke=\"#b26a39\" stroke-width=\"1\" opacity=\"0.7\"/><text x=\"562\" y=\"156\" font-size=\"8\" fill=\"#8e5229\">面波（高波数）</text><rect x=\"366\" y=\"34\" width=\"290\" height=\"130\" rx=\"0\" fill=\"rgba(121,130,138,.12)\"/><text x=\"650\" y=\"48\" font-size=\"8\" fill=\"#9ba3a9\" text-anchor=\"end\">随机噪声铺满全平面</text><text x=\"654\" y=\"176\" font-size=\"8\" fill=\"#9ba3a9\" text-anchor=\"end\">波数 k →</text><text x=\"364\" y=\"42\" font-size=\"8\" fill=\"#9ba3a9\" text-anchor=\"end\">f</text><text x=\"358\" y=\"190\" font-size=\"8.4\" fill=\"#9ba3a9\">传统去噪 = 在这个平面上划一刀；学习型去噪 = 学这个平面上的形状。</text></svg></div><div class=\"figcap\"><b>图 1</b><span>左：炮集上三类信号的形态。右：它们在 f–k 平面上的分布——去噪的本质是在这个平面上做分离。</span></div><p>这一步的理解直接决定了方法选择：带通滤波只能压「频率不同」的噪声，面波与有效波频率重叠时就无能为力；f–k 与 Radon 利用的是「波数不同」；学习型方法则同时利用频率、波数与空间连续性。</p>"
        },
        {
          "no": "02",
          "en": "TRADE-OFF",
          "title": "压得越狠，弱反射伤得越多",
          "html": "<p>去噪指标永远是两条曲线：一条是噪声压制率，一条是信号保真度。它们此消彼长，最优点在中间某处，而不是「越干净越好」。工程上判断有没有做过头，靠的是<b>差值剖面</b>：把去噪结果与原记录相减，如果差里能看到同相轴，说明有效信号被当成噪声去掉了。</p><div class=\"figure\"><svg viewBox=\"0 18 680 192\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"去噪的取舍\" style=\"font-family:-apple-system,'Segoe UI','Noto Sans SC','Microsoft YaHei',sans-serif\"><text x=\"6\" y=\"16\" font-size=\"9.2\" fill=\"#9ba3a9\">A · 去噪强度与信号保真是一对矛盾</text><line x1=\"50\" y1=\"170\" x2=\"300\" y2=\"170\" stroke=\"#dcd6c6\" stroke-width=\"1\" stroke-linecap=\"round\"/><line x1=\"50\" y1=\"170\" x2=\"50\" y2=\"50\" stroke=\"#dcd6c6\" stroke-width=\"1\" stroke-linecap=\"round\"/><path d=\"M60 140 L98.3333 126.8 L136.667 113.6 L175 100.4 L213.333 87.2 L251.667 74 L290 60.8\" fill=\"none\" stroke=\"#2f7d6b\" stroke-width=\"1.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><path d=\"M60 54.8 L98.3333 68.36 L136.667 83.84 L175 101.24 L213.333 120.56 L251.667 141.8 L290 164.96\" fill=\"none\" stroke=\"#b26a39\" stroke-width=\"1.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><rect x=\"54\" y=\"179\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#2f7d6b\"/><text x=\"67\" y=\"187\" font-size=\"8.4\" fill=\"#79828a\">噪声压制率</text><rect x=\"118.9\" y=\"179\" width=\"9\" height=\"9\" rx=\"2\" fill=\"#b26a39\"/><text x=\"131.9\" y=\"187\" font-size=\"8.4\" fill=\"#79828a\">信号保真度</text><circle cx=\"175\" cy=\"100.4\" r=\"4\" fill=\"#242b2e\"/><text x=\"170\" y=\"110\" font-size=\"8.4\" fill=\"#79828a\">最优点不在一端</text><text x=\"6\" y=\"192\" font-size=\"8.6\" fill=\"#9ba3a9\">压得越狠，弱反射伤得越多——这是去噪永远绕不开的取舍。</text><text x=\"350\" y=\"16\" font-size=\"9.2\" fill=\"#9ba3a9\">B · 三类方法的代价</text><text x=\"356\" y=\"44\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">带通滤波</text><text x=\"356\" y=\"58\" font-size=\"8.4\" fill=\"#79828a\">压面波有效，伤低频有效波</text><rect x=\"356\" y=\"66\" width=\"280\" height=\"6\" rx=\"3\" fill=\"#efece1\"/><rect x=\"356\" y=\"66\" width=\"154\" height=\"6\" rx=\"3\" fill=\"#b26a39\"/><text x=\"640\" y=\"72\" font-size=\"8.4\" fill=\"#b26a39\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">0.55</text><text x=\"356\" y=\"88\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">f–k / Radon</text><text x=\"356\" y=\"102\" font-size=\"8.4\" fill=\"#79828a\">保真较好，陡倾角处有假频</text><rect x=\"356\" y=\"110\" width=\"280\" height=\"6\" rx=\"3\" fill=\"#efece1\"/><rect x=\"356\" y=\"110\" width=\"201.6\" height=\"6\" rx=\"3\" fill=\"#41699b\"/><text x=\"640\" y=\"116\" font-size=\"8.4\" fill=\"#41699b\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">0.72</text><text x=\"356\" y=\"132\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">学习型去噪</text><text x=\"356\" y=\"146\" font-size=\"8.4\" fill=\"#79828a\">一次前向压多类噪声，需干净标签</text><rect x=\"356\" y=\"154\" width=\"280\" height=\"6\" rx=\"3\" fill=\"#efece1\"/><rect x=\"356\" y=\"154\" width=\"240.8\" height=\"6\" rx=\"3\" fill=\"#2f7d6b\"/><text x=\"640\" y=\"160\" font-size=\"8.4\" fill=\"#2f7d6b\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">0.86</text><text x=\"350\" y=\"184\" font-size=\"8.2\" fill=\"#9ba3a9\">横条是「综合效果」的主观打分，仅用于示意三种方法的相对差别。</text></svg></div><div class=\"figcap\"><b>图 2</b><span>左：压制率与保真度的此消彼长。右：三类方法的相对取舍；横条是示意打分，不是实测。</span></div><p>这也是为什么学习型去噪的评价不能只看 SNR：一个把所有能量都压掉的模型，SNR 会非常高，但剖面也没了。</p>"
        },
        {
          "no": "03",
          "en": "LABELS",
          "title": "标签从哪来：合成、重复采集、自监督",
          "html": "<p>监督去噪需要「同一位置的干净记录」，现实中几乎拿不到。三条现实路径：<b>合成数据</b>（正演得到干净记录，再叠加真实噪声）、<b>重复采集</b>（同一位置多次激发，取中位数当干净道）、<b>自监督</b>（把噪声分离出来再拼回去，构造训练对）。</p><div class=\"figure\"><svg viewBox=\"0 18 680 182\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"标签来源\" style=\"font-family:-apple-system,'Segoe UI','Noto Sans SC','Microsoft YaHei',sans-serif\"><rect x=\"6\" y=\"6\" width=\"300\" height=\"186\" rx=\"5\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"16\" y=\"24\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">干净标签从哪来</text><rect x=\"16\" y=\"32\" width=\"4\" height=\"40\" rx=\"2\" fill=\"#2f7d6b\"/><text x=\"28\" y=\"44\" font-size=\"9.4\" fill=\"#242b2e\" font-weight=\"600\">合成数据</text><text x=\"28\" y=\"58\" font-size=\"8.4\" fill=\"#79828a\">正演得到纯净记录，噪声可任意叠加</text><text x=\"28\" y=\"71\" font-size=\"8.2\" fill=\"#2f7d6b\">标签免费、分布可控</text><rect x=\"16\" y=\"82\" width=\"4\" height=\"40\" rx=\"2\" fill=\"#41699b\"/><text x=\"28\" y=\"94\" font-size=\"9.4\" fill=\"#242b2e\" font-weight=\"600\">重复采集</text><text x=\"28\" y=\"108\" font-size=\"8.4\" fill=\"#79828a\">同一位置多次激发，取中位数当干净道</text><text x=\"28\" y=\"121\" font-size=\"8.2\" fill=\"#41699b\">成本高，只覆盖试验区</text><rect x=\"16\" y=\"132\" width=\"4\" height=\"40\" rx=\"2\" fill=\"#b26a39\"/><text x=\"28\" y=\"144\" font-size=\"9.4\" fill=\"#242b2e\" font-weight=\"600\">自监督</text><text x=\"28\" y=\"158\" font-size=\"8.4\" fill=\"#79828a\">把噪声从记录里「分离」出来再拼回去</text><text x=\"28\" y=\"171\" font-size=\"8.2\" fill=\"#b26a39\">不需要干净标签</text><text x=\"350\" y=\"24\" font-size=\"9.6\" fill=\"#242b2e\">合成数据：噪声—信号对可以无限造</text><rect x=\"350\" y=\"44\" width=\"96\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"354\" y=\"58\" font-size=\"8\" fill=\"#79828a\">干净记录</text><path d=\"M350 66 L446 66\" fill=\"none\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><line x1=\"448\" y1=\"62\" x2=\"466.4\" y2=\"62\" stroke=\"#9ba3a9\" stroke-width=\"1\" stroke-linecap=\"round\"/><polygon points=\"470,62 466,64.2 466,59.8\" fill=\"#9ba3a9\"/><rect x=\"474\" y=\"44\" width=\"70\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"478\" y=\"58\" font-size=\"8\" fill=\"#b26a39\">+ 噪声</text><line x1=\"546\" y1=\"62\" x2=\"564.4\" y2=\"62\" stroke=\"#9ba3a9\" stroke-width=\"1\" stroke-linecap=\"round\"/><polygon points=\"568,62 564,64.2 564,59.8\" fill=\"#9ba3a9\"/><rect x=\"572\" y=\"44\" width=\"96\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"576\" y=\"58\" font-size=\"8\" fill=\"#2f7d6b\">训练样本对</text><rect x=\"350\" y=\"90\" width=\"96\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"354\" y=\"104\" font-size=\"8\" fill=\"#79828a\">干净记录</text><path d=\"M350 112 L446 112\" fill=\"none\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><line x1=\"448\" y1=\"108\" x2=\"466.4\" y2=\"108\" stroke=\"#9ba3a9\" stroke-width=\"1\" stroke-linecap=\"round\"/><polygon points=\"470,108 466,110.2 466,105.8\" fill=\"#9ba3a9\"/><rect x=\"474\" y=\"90\" width=\"70\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"478\" y=\"104\" font-size=\"8\" fill=\"#b26a39\">+ 噪声</text><line x1=\"546\" y1=\"108\" x2=\"564.4\" y2=\"108\" stroke=\"#9ba3a9\" stroke-width=\"1\" stroke-linecap=\"round\"/><polygon points=\"568,108 564,110.2 564,105.8\" fill=\"#9ba3a9\"/><rect x=\"572\" y=\"90\" width=\"96\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"576\" y=\"104\" font-size=\"8\" fill=\"#2f7d6b\">训练样本对</text><rect x=\"350\" y=\"136\" width=\"96\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"354\" y=\"150\" font-size=\"8\" fill=\"#79828a\">干净记录</text><path d=\"M350 158 L446 158\" fill=\"none\" stroke=\"#9ba3a9\" stroke-width=\"0.8\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/><line x1=\"448\" y1=\"154\" x2=\"466.4\" y2=\"154\" stroke=\"#9ba3a9\" stroke-width=\"1\" stroke-linecap=\"round\"/><polygon points=\"470,154 466,156.2 466,151.8\" fill=\"#9ba3a9\"/><rect x=\"474\" y=\"136\" width=\"70\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"478\" y=\"150\" font-size=\"8\" fill=\"#b26a39\">+ 噪声</text><line x1=\"546\" y1=\"154\" x2=\"564.4\" y2=\"154\" stroke=\"#9ba3a9\" stroke-width=\"1\" stroke-linecap=\"round\"/><polygon points=\"568,154 564,156.2 564,151.8\" fill=\"#9ba3a9\"/><rect x=\"572\" y=\"136\" width=\"96\" height=\"36\" rx=\"4\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"576\" y=\"150\" font-size=\"8\" fill=\"#2f7d6b\">训练样本对</text><text x=\"350\" y=\"186\" font-size=\"8.4\" fill=\"#b05a51\">但要小心：合成噪声与真实噪声的统计差异，是这类方法落地失败的主因。</text></svg></div><div class=\"figcap\"><b>图 3</b><span>三条标签来源路线与各自的代价。合成数据最常用，但合成噪声与真实噪声的统计差异是落地失败的主因。</span></div><p>所以这类工作的真正难点不在网络结构，而在<b>噪声建模</b>：能不能把真实面波的频散、振幅衰减、空间相关性模拟对。</p>"
        },
        {
          "no": "04",
          "en": "EVALUATION",
          "title": "评价：SNR、保真度、假象，三件事",
          "html": "<p>本案例用三个指标：<b>SNR</b>（信号能量 / 残差能量）、<b>保真度</b>（去噪结果与干净记录的相关系数）、<b>面波残留</b>（面波所在时窗内的残余能量）。三者要一起看，单看任何一个都会被误导。</p><div class=\"figure\"><svg viewBox=\"0 18 680 188\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"评价指标\" style=\"font-family:-apple-system,'Segoe UI','Noto Sans SC','Microsoft YaHei',sans-serif\"><rect x=\"6\" y=\"6\" width=\"320\" height=\"190\" rx=\"5\" fill=\"#f8f6ef\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><text x=\"16\" y=\"24\" font-size=\"9.4\" fill=\"#242b2e\" font-weight=\"600\">差值剖面：原记录 − 去噪结果</text><line x1=\"20\" y1=\"46\" x2=\"312\" y2=\"46\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\" opacity=\"0.45\"/><line x1=\"20\" y1=\"60\" x2=\"312\" y2=\"60\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\" opacity=\"0.45\"/><line x1=\"20\" y1=\"74\" x2=\"312\" y2=\"74\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\" opacity=\"0.45\"/><line x1=\"20\" y1=\"88\" x2=\"312\" y2=\"88\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\" opacity=\"0.45\"/><line x1=\"20\" y1=\"102\" x2=\"312\" y2=\"102\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\" opacity=\"0.45\"/><path d=\"M20 118 L312 118\" fill=\"none\" stroke=\"#b05a51\" stroke-width=\"1.6\" stroke-linejoin=\"round\" stroke-linecap=\"round\" stroke-dasharray=\"5 4\"/><text x=\"120\" y=\"112\" font-size=\"8.4\" fill=\"#b05a51\">差里出现同相轴 = 伤了有效信号</text><text x=\"344\" y=\"24\" font-size=\"9.4\" fill=\"#242b2e\">三个指标各看一件事</text><rect x=\"344\" y=\"34\" width=\"3\" height=\"34\" rx=\"2\" fill=\"#2f7d6b\"/><text x=\"354\" y=\"48\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">SNR</text><text x=\"354\" y=\"62\" font-size=\"8.4\" fill=\"#79828a\">信号能量 / 残差能量</text><text x=\"650\" y=\"62\" font-size=\"8.4\" fill=\"#2f7d6b\" text-anchor=\"end\">压得干不干净</text><rect x=\"344\" y=\"80\" width=\"3\" height=\"34\" rx=\"2\" fill=\"#41699b\"/><text x=\"354\" y=\"94\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">保真度</text><text x=\"354\" y=\"108\" font-size=\"8.4\" fill=\"#79828a\">与干净记录的相关系数</text><text x=\"650\" y=\"108\" font-size=\"8.4\" fill=\"#41699b\" text-anchor=\"end\">有没有压过头</text><rect x=\"344\" y=\"126\" width=\"3\" height=\"34\" rx=\"2\" fill=\"#b26a39\"/><text x=\"354\" y=\"140\" font-size=\"9.6\" fill=\"#242b2e\" font-weight=\"600\">面波残留</text><text x=\"354\" y=\"154\" font-size=\"8.4\" fill=\"#79828a\">面波时窗内的残余能量</text><text x=\"650\" y=\"154\" font-size=\"8.4\" fill=\"#b26a39\" text-anchor=\"end\">最强噪声处理得如何</text><text x=\"344\" y=\"190\" font-size=\"8.4\" fill=\"#9ba3a9\">只看 SNR 会被「全部压掉」骗到：那时 SNR 最高，剖面最干净，也最没用。</text></svg></div><div class=\"figcap\"><b>图 4</b><span>差值剖面是判断「有没有伤及有效信号」的直接证据；三项指标各管一件事，缺一不可。</span></div><p>还要看<b>假象</b>：学习型方法有时会在原本没有能量的地方「生成」同相轴，这类错误在叠加剖面上表现为虚假的构造，比噪声本身更危险。</p>"
        }
      ]
    },
    "workflow": {
      "label": "案例流程",
      "title": "从含噪炮集到可用的去噪记录",
      "lead": [
        "示范页把三种方法放在同一炮集上：**带通滤波**（只用频率差异）、**空间中值**（利用空间连续性）、以及**理想减除**（已知真噪声时的上限）。",
        "三者对比能看清一件事：方法之间的差距，本质是「用了多少维度的信息」。"
      ],
      "stats": [
        [
          "工区",
          "三维 32 束线"
        ],
        [
          "道数",
          "12 万道"
        ],
        [
          "合成对",
          "12 万对"
        ],
        [
          "训练",
          "1 × A100 · 22 h"
        ]
      ],
      "figure": {
        "title": "五步数据流：去噪不是终点，叠加剖面才是",
        "lead": "最后一格的 QC 通过与否，取决于差值剖面里有没有同相轴，而不是 SNR 数字。",
        "html": "<svg viewBox=\"0 18 680 182\" xmlns=\"http://www.w3.org/2000/svg\" role=\"img\" aria-label=\"去噪数据流\" style=\"font-family:-apple-system,'Segoe UI','Noto Sans SC','Microsoft YaHei',sans-serif\"><rect x=\"6\" y=\"8\" width=\"118\" height=\"72\" rx=\"6\" fill=\"#ffffff\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><rect x=\"6\" y=\"8\" width=\"3\" height=\"72\" rx=\"2\" fill=\"#2f7d6b\"/><text x=\"18\" y=\"28\" font-size=\"10.2\" fill=\"#242b2e\" font-weight=\"600\">含噪炮集</text><text x=\"18\" y=\"44\" font-size=\"8.6\" fill=\"#79828a\">面波 + 随机噪声</text><text x=\"77\" y=\"71\" font-size=\"8.2\" fill=\"#2f7d6b\" text-anchor=\"middle\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">1.8 GB</text><line x1=\"126\" y1=\"44\" x2=\"134.4\" y2=\"44\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\"/><polygon points=\"138,44 134,46.2 134,41.8\" fill=\"#9ba3a9\"/><rect x=\"140\" y=\"8\" width=\"118\" height=\"72\" rx=\"6\" fill=\"#ffffff\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><rect x=\"140\" y=\"8\" width=\"3\" height=\"72\" rx=\"2\" fill=\"#2f7d6b\"/><text x=\"152\" y=\"28\" font-size=\"10.2\" fill=\"#242b2e\" font-weight=\"600\">合成数据</text><text x=\"152\" y=\"44\" font-size=\"8.6\" fill=\"#79828a\">正演 + 噪声叠加</text><text x=\"211\" y=\"71\" font-size=\"8.2\" fill=\"#2f7d6b\" text-anchor=\"middle\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">12 万对</text><line x1=\"260\" y1=\"44\" x2=\"268.4\" y2=\"44\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\"/><polygon points=\"272,44 268,46.2 268,41.8\" fill=\"#9ba3a9\"/><rect x=\"274\" y=\"8\" width=\"118\" height=\"72\" rx=\"6\" fill=\"#ffffff\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><rect x=\"274\" y=\"8\" width=\"3\" height=\"72\" rx=\"2\" fill=\"#2f7d6b\"/><text x=\"286\" y=\"28\" font-size=\"10.2\" fill=\"#242b2e\" font-weight=\"600\">去噪网络</text><text x=\"286\" y=\"44\" font-size=\"8.6\" fill=\"#79828a\">U-Net / DnCNN</text><text x=\"345\" y=\"71\" font-size=\"8.2\" fill=\"#2f7d6b\" text-anchor=\"middle\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">8.4 M</text><line x1=\"394\" y1=\"44\" x2=\"402.4\" y2=\"44\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\"/><polygon points=\"406,44 402,46.2 402,41.8\" fill=\"#9ba3a9\"/><rect x=\"408\" y=\"8\" width=\"118\" height=\"72\" rx=\"6\" fill=\"#ffffff\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><rect x=\"408\" y=\"8\" width=\"3\" height=\"72\" rx=\"2\" fill=\"#41699b\"/><text x=\"420\" y=\"28\" font-size=\"10.2\" fill=\"#242b2e\" font-weight=\"600\">质量评估</text><text x=\"420\" y=\"44\" font-size=\"8.6\" fill=\"#79828a\">SNR + 保真度 + 假象</text><text x=\"479\" y=\"71\" font-size=\"8.2\" fill=\"#41699b\" text-anchor=\"middle\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">3 项指标</text><line x1=\"528\" y1=\"44\" x2=\"536.4\" y2=\"44\" stroke=\"#9ba3a9\" stroke-width=\"1.1\" stroke-linecap=\"round\"/><polygon points=\"540,44 536,46.2 536,41.8\" fill=\"#9ba3a9\"/><rect x=\"542\" y=\"8\" width=\"118\" height=\"72\" rx=\"6\" fill=\"#ffffff\" stroke=\"#e9e4d8\" stroke-width=\"1\"/><rect x=\"542\" y=\"8\" width=\"3\" height=\"72\" rx=\"2\" fill=\"#41699b\"/><text x=\"554\" y=\"28\" font-size=\"10.2\" fill=\"#242b2e\" font-weight=\"600\">叠加剖面</text><text x=\"554\" y=\"44\" font-size=\"8.6\" fill=\"#79828a\">交给成像</text><text x=\"613\" y=\"71\" font-size=\"8.2\" fill=\"#41699b\" text-anchor=\"middle\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\">QC 通过</text><text x=\"6\" y=\"104\" font-size=\"9.2\" fill=\"#79828a\">关键指标不是「看起来干净」，而是「弱反射还在不在」：去噪结果必须与原始记录做差，看差里有没有信号。</text><line x1=\"6\" y1=\"114\" x2=\"674\" y2=\"114\" stroke=\"#e9e4d8\" stroke-width=\"1\" stroke-linecap=\"round\"/><text x=\"6\" y=\"134\" font-size=\"8.6\" fill=\"#9ba3a9\" font-family=\"ui-monospace,SFMono-Regular,Consolas,'Liberation Mono',monospace\" letter-spacing=\".08em\">本案例示范</text><rect x=\"78\" y=\"123\" width=\"107.96\" height=\"17\" rx=\"8.5\" fill=\"#e6f1ec\"/><text x=\"131.98\" y=\"134.74\" font-size=\"9\" fill=\"#235f51\" text-anchor=\"middle\">带通 vs 空间中值 vs 理想减除</text><text x=\"320\" y=\"134\" font-size=\"9\" fill=\"#9ba3a9\">三种方法在同一炮集上的 SNR 与保真度对比。</text><text x=\"6\" y=\"158\" font-size=\"9\" fill=\"#b26a39\">理想减除是「知道真噪声长什么样」时的上限，用来标定还能提升多少。</text><text x=\"6\" y=\"178\" font-size=\"9\" fill=\"#9ba3a9\">真实项目里这个上限永远拿不到，但它告诉我们：方法选择的天花板在哪里。</text></svg>",
        "caption": "红色为模型部分，蓝色为交付部分。"
      },
      "steps": [
        {
          "name": "噪声建模与合成",
          "role": "数据",
          "do": "统计面波的频散曲线、视速度与振幅衰减，建立参数化噪声模型；把真实随机噪声按信噪比分档叠加到正演记录上。",
          "effect": "12 万对训练样本，覆盖 6 个信噪比档；面波视速度与实际误差 < 8%。",
          "trap": "用高斯白噪声代替真实噪声。模型学到的是「去高斯噪声」，上真实数据几乎无效。"
        },
        {
          "name": "分块与归一化",
          "role": "特征",
          "do": "按 128×128 分块，重叠 32；每块按自身能量归一化，避免强面波块主导损失。",
          "effect": "训练稳定，弱信号块不被强噪声块淹没。",
          "trap": "全局归一化。强面波区的块会把动态范围占满，弱反射区在输入里几乎是零。"
        },
        {
          "name": "去噪网络训练",
          "role": "模型",
          "do": "U-Net（8.4 M）+ L1 损失 + 结构相似度项；训练时混入 5% 的纯噪声块做负样本，抑制「生成」倾向。",
          "effect": "合成测试集 SNR 提升 14.2 dB，保真度 0.93。",
          "trap": "只用 L2 损失。L2 倾向于输出平滑的平均结果，弱同相轴会被抹平。"
        },
        {
          "name": "质量评估与差值检查",
          "role": "验证",
          "do": "计算 SNR、保真度、面波残留；同时输出「原记录 − 去噪结果」的差值剖面，人工检查差值里有没有同相轴。",
          "effect": "差值剖面干净，说明没有伤及有效信号；发现 2 处弱反射被削弱，调整损失权重后修复。",
          "trap": "只看 SNR。把全部能量压掉时 SNR 最高，剖面却什么都没有。"
        },
        {
          "name": "叠加成像验证",
          "role": "交付",
          "do": "把去噪结果送入后续流程做叠加，比较叠加剖面的同相轴连续性与信噪比；这才是最终验收。",
          "effect": "叠加剖面信噪比提升 6.8 dB，深层弱反射可连续追踪。",
          "trap": "在炮集上验收完就结束。炮集好看不代表叠加好看，成像才是目的。"
        }
      ],
